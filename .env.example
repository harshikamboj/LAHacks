# Copy to .env and fill in. Never commit .env.

# --- MongoDB Atlas Sandbox (runtime access via PyMongo with the app's own limited user) ---
MONGODB_URI=mongodb+srv://<app-user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=tradeops
# Setup only: a separate user with readWrite + dbAdmin on tradeops, scoped to this cluster.
# API/worker code must use MONGODB_URI, never this credential.
MONGODB_SETUP_URI=mongodb+srv://<setup-user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_TIMEOUT_MS=10000
MONGODB_VECTOR_INDEX=incident_vector_index
ATLAS_PROJECT_ID=
ATLAS_CLUSTER_NAME=
# true only after matching the organizer's actual invitation, not a cluster's name.
ATLAS_SANDBOX_CONFIRMED=false

# --- Embeddings for Atlas Vector Search (Voyage AI) ---
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite
MEMORY_ENABLED=true            # set false for the paired retrieval-off run

# --- Simulated external systems (each its own process + SQLite file) ---
BROKER_URL=http://127.0.0.1:8101
DIRECTORY_URL=http://127.0.0.1:8102
CUSTODIAN_URL=http://127.0.0.1:8103
SIM_DATA_DIR=backend/simulators/data
SIM_ADMIN_TOKEN=change-me-sim-admin
LOST_RESPONSE_DELAY_SECONDS=10

# --- Worker ---
CUSTODIAN_TIMEOUT_SECONDS=3
WORKER_POLL_SECONDS=1

# --- Demo mode (local only) ---
DEMO_MODE=true
DEMO_REVIEWER_ID=demo-reviewer
DEMO_REVIEWER_TOKEN=change-me-reviewer-token
